# Copy to .env and fill in
BOT_TOKEN=123456:ABC-your-telegram-bot-token
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/nairagivebot?sslmode=require
PORT=3000
TIMEZONE=Africa/Lagos
TZ=Africa/Lagos

# Winner seed secret — keep private. Changing it changes future winner picks.
WINNER_SEED_SECRET=generate-a-long-random-string-here

# Admin dashboard auth
ADMIN_SECRET=generate-another-long-random-string

# Hourly giveaway
HOURLY_AMOUNT=200
HOURLY_PREFIX=NG
MAX_TICKETS_PER_USER=10

# Sponsor shown on ticket entry page
SPONSOR_NAME=NaijaGiveawayBot
SPONSOR_LINK=https://t.me/nairagivebot
SPONSOR_BIO=Proudly powering free hourly 200 naira giveaways for our community.

# Mini App (Telegram Web App) — public HTTPS URL serving index.html, e.g. Render URL.
# Register it in BotFather via /newapp, then the bot /start + /app buttons open it.
MINI_APP_URL=https://nairagivebot.onrender.com/

# Browser test mode (DEV ONLY): lets index.html claim tickets + wallet in a
# desktop browser without Telegram via X-Test-User header. NEVER enable in prod.
ALLOW_TEST_MODE=true

CONTACT_TEXT=Questions or sponsorships? Contact @nairagivebot_admin or email support@example.com
HOW_TO_USE_TEXT=
RULES_TEXT=
WITHDRAW_MIN=100
